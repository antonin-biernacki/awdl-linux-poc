+    def _read_body(self):
+        """
+        Read the request body, whether it is sent with a Content-Length header
+        or with chunked transfer encoding (as recent iOS versions do)
+        """
+        if self.headers.get("transfer-encoding", "").lower() == "chunked":
+            body = b""
+            while True:
+                length = int(self.rfile.readline().split(b";")[0].strip(), 16)
+                if length == 0:
+                    # skip optional trailers up to the final empty line
+                    while self.rfile.readline().strip():
+                        pass
+                    return body
+                body += self.rfile.read(length)
+                self.rfile.readline()  # strip trailing \r\n
+        content_length = self.headers.get("Content-Length")
+        return self.rfile.read(int(content_length)) if content_length else b""
+
