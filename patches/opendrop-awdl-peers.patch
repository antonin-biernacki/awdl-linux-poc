+class AwdlPeerInfo:
+    """
+    Stands for a zeroconf ServiceInfo, for a receiver found in AWDL frames.
+    """
+
+    def __init__(self, mac, port, instance, flags):
+        octets = [int(x, 16) for x in mac.split(":")]
+        octets[0] ^= 0x02  # EUI-64: flip the universal/local bit
+        eui64 = octets[:3] + [0xFF, 0xFE] + octets[3:]
+        groups = [f"{eui64[i] << 8 | eui64[i + 1]:x}" for i in range(0, 8, 2)]
+        self.address = "fe80::" + ":".join(groups)
+        self.port = int(port)
+        self.name = f"{instance}._airdrop._tcp.local."
+        self.server = f"{instance}.local."
+        self.properties = {b"flags": flags.encode()}
+
+    def parsed_addresses(self):
+        return [self.address]
+
+
