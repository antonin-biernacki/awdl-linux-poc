+    def _watch_peers_file(self):
+        """
+        Apple receivers announce their AirDrop service in AWDL frames (Service
+        Response TLVs), not with mDNS on awdl0, and OWL does not forward them.
+        Read the receivers another program extracted from these frames and
+        handle each new one like a receiver found with mDNS.
+        """
+        seen = set()
+        while True:
+            try:
+                with open(self.peers_file) as f:
+                    lines = f.read().splitlines()
+            except FileNotFoundError:
+                lines = []
+            for line in lines:
+                fields = line.split()
+                if len(fields) != 4 or line in seen:
+                    continue
+                seen.add(line)
+                mac, port, instance, flags = fields
+                logger.debug(f"AirDrop receiver from AWDL frames: {line}")
+                self._found_receiver(AwdlPeerInfo(mac, port, instance, flags))
+            time.sleep(1)
+
     def _found_receiver(self, info):
         thread = threading.Thread(target=self._send_discover, args=(info,))
         thread.start()
