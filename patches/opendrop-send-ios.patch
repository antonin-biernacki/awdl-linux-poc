+# Type (UTI) declared to the receiver, from the file extension as macOS does.
+# iOS uses it to choose where the file goes: Photos for images and videos,
+# Files for the rest. fleep, OpenDrop's content sniffer, misses HEIC and text.
+UTI_BY_EXTENSION = {
+    ".heic": "public.heic",
+    ".heif": "public.heif",
+    ".jpg": "public.jpeg",
+    ".jpeg": "public.jpeg",
+    ".png": "public.png",
+    ".gif": "com.compuserve.gif",
+    ".tif": "public.tiff",
+    ".tiff": "public.tiff",
+    ".webp": "org.webmproject.webp",
+    ".dng": "com.adobe.raw-image",
+    ".mov": "com.apple.quicktime-movie",
+    ".mp4": "public.mpeg-4",
+    ".m4v": "com.apple.m4v-video",
+    ".mp3": "public.mp3",
+    ".m4a": "com.apple.m4a-audio",
+    ".txt": "public.plain-text",
+    ".pdf": "com.adobe.pdf",
+    ".zip": "public.zip-archive",
+    ".vcf": "public.vcard",
+}
+
+
+def uti_type(file_path, flp):
+    """
+    UTI of the file: from its extension, else from fleep's guess.
+    """
+    ext = os.path.splitext(file_path)[1].lower()
+    return UTI_BY_EXTENSION.get(ext) or AirDropUtil.get_uti_type(flp)
